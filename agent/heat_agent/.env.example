# Copy to agent/heat_agent/.env for `adk web` / `adk run`. (The portal sets these itself.)
# Gemini on Vertex AI, billed to the team project, using your gcloud application-default login.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-03-941c9ce79592
GOOGLE_CLOUD_LOCATION=us-central1
# HEAT_AGENT_MODEL=gemini-2.5-flash

# TOOLBOX_URL=https://heatrx-toolbox-xxxxx-uc.a.run.app
# HEAT_AGENT_MODE=team                # router + dispatch_agent + planning_agent (default: single)
# GOOGLE_MAPS_API_KEY=                # optional: inspect_site (Street View + Gemini vision)
