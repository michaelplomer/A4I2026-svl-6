{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "heat-portal",
      "runtimeExecutable": "portal/.venv/bin/uvicorn",
      "runtimeArgs": [
        "backend.main:app",
        "--app-dir",
        "portal",
        "--reload",
        "--reload-dir",
        "portal",
        "--port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "heat-portal-8081",
      "runtimeExecutable": "portal/.venv/bin/uvicorn",
      "runtimeArgs": [
        "backend.main:app",
        "--app-dir",
        "portal",
        "--reload",
        "--reload-dir",
        "portal",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "heat-portal-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AGENT_MODE=mock",
        "portal/.venv/bin/uvicorn",
        "backend.main:app",
        "--app-dir",
        "portal",
        "--port",
        "8090"
      ],
      "port": 8090
    }
  ]
}